DATABASE_URL=postgres://postgres:stampdraft@127.0.0.1:5432/postgres
# Required for production and every non-loopback deployment. Use at least 32 random bytes.
STAMPDRAFT_MEMO_CAPABILITY_SECRET=
# Required for the protected retention-expiry scheduler endpoint. Use a
# different secret of at least 32 random bytes.
STAMPDRAFT_OPERATIONS_SECRET=
# Omit or keep this strict value in production. Local draft mode also requires
# STAMPDRAFT_LOCAL_DRAFT_ACK=UNVERIFIED_LOCAL_ONLY and accepts loopback only.
STAMPDRAFT_EXECUTION_POLICY=verified-evidence
