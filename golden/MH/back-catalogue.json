  {
    "name": "MH Works contract (historical) — ceiling step: a PART slab counts in full",
    "source_note": "Pre-2015: Rs 100 + Rs 100 per Rs 1,00,000 'or part thereof' above Rs 10L. Value 10,50,000 → excess 50,000 → ceil(50,000/1,00,000) = 1 FULL slab → 100 + 100 = 200. A plain division would give 150 — under-charging. This is why ceil_div exists.",
    "input": {
      "jurisdiction": "MH",
      "rule_id": "MH-ART63-works-contract",
      "execution_date": "2015-03-01",
      "values": {
        "contract_value": "1050000"
      }
    },
    "expect": {
      "total_duty": "200"
    }
  },
