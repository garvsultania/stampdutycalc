{
  "name": "stampdraft",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "watchdog": "tsc -b packages/watchdog && node packages/watchdog/dist/cli.js",
    "validate:rules": "tsx scripts/validate-rules.ts",
    "validate:evidence": "tsx scripts/validate-evidence.ts --check-report",
    "validate:proposals": "tsx scripts/validate-evidence-proposals.ts --check-report",
    "golden": "tsx scripts/run-golden.ts",
    "check": "pnpm typecheck && pnpm validate:rules && pnpm validate:evidence && pnpm validate:proposals && pnpm golden && pnpm test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@stampdraft/engine": "workspace:*",
    "@stampdraft/schema": "workspace:*",
    "@types/node": "^20.14.15",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "zod": "^3.23.8"
  }
}
