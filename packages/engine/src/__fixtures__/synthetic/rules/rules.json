        { "kind": "ad_valorem", "base": { "var": "chargeable_rent" }, "pct": 5 },
        { "kind": "cross_ref", "rule_id": "SYN-conveyance", "on": { "var": "premium" } }
      ]
    },
    "rounding": { "mode": "ceil", "nearest": 100 },
    "notes_for_reviewer": "Synthetic: formula base (lease rent-multiple) + premium-as-conveyance via cross-ref rebase."
